# Written by ./lab/setup.sh. Copy to .env and fill in your project to run by hand.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Where Gemini is called. "global" spreads load across regions (fewer 429s).
# The agent itself deploys to us-central1 (see agents-cli-manifest.yaml).
GOOGLE_CLOUD_LOCATION=global
